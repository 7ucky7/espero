<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>

    <!-- one #12 carry paper book, looping; scripts/install-carry-launchd.sh renders one per book -->
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-m</string>
        <string>espero</string>
        <string>carry</string>
        <string>paper</string>
        <string>--costs</string>
        <string>__COSTS__</string>
        <string>--state</string>
        <string>__STATE__</string>
        <string>--loop</string>
        __EXECUTE__
    </array>

    <!-- the repo: the .env with the testnet key is read from here -->
    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <!-- start at login and restart whenever the loop dies, at most once a minute. A
         restart rebuilds up to 72 missed hours from funding history (carry_paper.py);
         a Mac asleep longer than that loses the hours past it. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/__NAME__.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/__NAME__.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <!-- Standard, not Background: a loop that wakes every five minutes should not
         have its timers deferred -->
    <key>ProcessType</key>
    <string>Standard</string>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>

# Copy to .env and fill in. NEVER commit .env (it is gitignored).
#
# Coinbase Advanced Trade (CDP) keys:
#   create them at https://portal.cdp.coinbase.com/ -> API keys
#   COINBASE_API_KEY is the key *name* (organizations/.../apiKeys/...)
#   COINBASE_API_SECRET is the EC private key PEM, newlines included
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Live orders are refused unless this is exactly "1" AND --confirm-live is passed.
ESPERO_ALLOW_LIVE=0
